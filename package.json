{
  "name": "@agile-hub/docx-html",
  "version": "0.1.0",
  "description": "TypeScript DOCX to HTML and JSON converter with fonts, tables, images and OMML math",
  "type": "module",
  "files": [
    "dist",
    "docs/architecture.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": { "@napi-rs/canvas": false },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./browser-metafile": {
      "types": "./dist/browser-metafile.d.ts",
      "import": "./dist/browser-metafile.js",
      "require": "./dist/browser-metafile.cjs"
    },
    "./browser": "./dist/docx-html.umd.cjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "check:architecture": "node scripts/check-architecture.ts",
    "check": "npm run check:architecture && npm run typecheck && npm test",
    "build": "npm run check:architecture && npm run typecheck && vite build --config vite.lib.config.ts && vite build --config vite.browser.config.ts && tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run build && npm run test:e2e",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "^1.0.13",
    "@xmldom/xmldom": "0.9.12",
    "canvg": "^4.0.3",
    "emf-converter": "4.21.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
